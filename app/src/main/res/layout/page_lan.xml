<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/PageTitle"
            android:text="@string/lan_title" />

        <TextView
            style="@style/PageSubtitle"
            android:text="@string/lan_subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- 服务地址卡片：大号字展示 IP，手动输入即可访问。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/lan_state_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_online" />

                    <TextView
                        android:id="@+id/lan_state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="服务运行中" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lan_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/primaryStrong"
                        android:textIsSelectable="true"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="192.168.1.23" />

                    <TextView
                        android:id="@+id/lan_port"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/textSecondary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text=":8080" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lan_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp"
                    tools:text="在电脑浏览器地址栏输入上面的地址即可访问" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lan_copy"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_copy"
                            android:tint="@color/onPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/lan_copy"
                            android:textColor="@color/onPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lan_share"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_share"
                            android:tint="@color/textPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/lan_share"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatCard">

                    <TextView
                        android:id="@+id/stat_clients"
                        style="@style/StatValue"
                        android:text="0" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/lan_stat_clients" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/StatCard">

                    <TextView
                        android:id="@+id/stat_messages"
                        style="@style/StatValue"
                        android:text="0" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/lan_stat_messages" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout style="@style/StatCard">

                    <TextView
                        android:id="@+id/stat_files"
                        style="@style/StatValue"
                        android:maxLines="1"
                        android:text="0 B" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/lan_stat_files" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/lan_link_chat"
                    style="@style/LinkRow">

                    <ImageView
                        style="@style/LinkIcon"
                        android:backgroundTint="@color/primaryTint"
                        android:src="@drawable/ic_chat"
                        android:tint="@color/colorPrimary" />

                    <LinearLayout style="@style/LinkTexts">

                        <TextView
                            style="@style/LinkTitle"
                            android:text="@string/lan_web_chat" />

                        <TextView
                            style="@style/LinkSubtitle"
                            android:fontFamily="monospace"
                            android:text="/index.html" />
                    </LinearLayout>

                    <ImageView style="@style/LinkChevron" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_marginStart="62dp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:id="@+id/lan_link_files"
                    style="@style/LinkRow">

                    <ImageView
                        style="@style/LinkIcon"
                        android:backgroundTint="@color/accentSoft"
                        android:src="@drawable/ic_folder"
                        android:tint="@color/colorAccent" />

                    <LinearLayout style="@style/LinkTexts">

                        <TextView
                            style="@style/LinkTitle"
                            android:text="@string/lan_web_files" />

                        <TextView
                            style="@style/LinkSubtitle"
                            android:fontFamily="monospace"
                            android:text="/file.html" />
                    </LinearLayout>

                    <ImageView style="@style/LinkChevron" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_marginStart="62dp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:id="@+id/lan_permission_row"
                    style="@style/LinkRow">

                    <ImageView
                        style="@style/LinkIcon"
                        android:backgroundTint="@color/surface2"
                        android:src="@drawable/ic_shield"
                        android:tint="@color/textSecondary" />

                    <LinearLayout style="@style/LinkTexts">

                        <TextView
                            style="@style/LinkTitle"
                            android:text="@string/lan_permission" />

                        <TextView
                            style="@style/LinkSubtitle"
                            android:text="@string/lan_permission_desc" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lan_permission_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:background="@drawable/bg_status_ok"
                        tools:text="已授权" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_marginStart="62dp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:id="@+id/lan_clear_row"
                    style="@style/LinkRow">

                    <ImageView
                        style="@style/LinkIcon"
                        android:backgroundTint="@color/dangerSoft"
                        android:src="@drawable/ic_trash"
                        android:tint="@color/danger" />

                    <LinearLayout style="@style/LinkTexts">

                        <TextView
                            style="@style/LinkTitle"
                            android:text="@string/clear_all"
                            android:textColor="@color/danger" />

                        <TextView
                            style="@style/LinkSubtitle"
                            android:text="@string/lan_clear_desc" />
                    </LinearLayout>

                    <ImageView style="@style/LinkChevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
