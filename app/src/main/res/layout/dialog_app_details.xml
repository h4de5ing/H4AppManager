<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_grabber" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/detail_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            tools:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="应用名称" />

            <TextView
                android:id="@+id/detail_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="monospace"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                tools:text="com.example.app" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/action_open"
            style="@style/SheetAction"
            android:background="@drawable/bg_action_primary">

            <ImageView
                style="@style/SheetActionIcon"
                android:src="@drawable/ic_open"
                android:tint="@color/onPrimary" />

            <TextView
                style="@style/SheetActionLabel"
                android:text="@string/open_app"
                android:textColor="@color/onPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_share"
            style="@style/SheetAction">

            <ImageView
                style="@style/SheetActionIcon"
                android:src="@drawable/ic_share" />

            <TextView
                style="@style/SheetActionLabel"
                android:text="@string/share_apk" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_export"
            style="@style/SheetAction">

            <ImageView
                style="@style/SheetActionIcon"
                android:src="@drawable/ic_download" />

            <TextView
                style="@style/SheetActionLabel"
                android:text="@string/export_apk" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_settings"
            style="@style/SheetAction">

            <ImageView
                style="@style/SheetActionIcon"
                android:src="@drawable/ic_tune" />

            <TextView
                style="@style/SheetActionLabel"
                android:text="@string/app_settings" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/detail_basic" />

            <LinearLayout
                android:id="@+id/detail_basic_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="2dp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="12dp"
                android:text="@string/detail_signature" />

            <LinearLayout
                android:id="@+id/detail_signature_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
